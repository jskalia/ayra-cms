{
  "name": "ayra-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.mts && next build",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "tsx scripts/sync.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-multi-tenant": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "next": "16.3.5",
    "payload": "3.91.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ajv": "8.20.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
