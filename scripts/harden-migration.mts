/**
 * Makes a migration generated by `payload migrate:create` safe to re-run (idempotent), the way
 * every migration in this repo is: production was built in steps, so a statement must skip what
 * already exists instead of failing. Rewrites only the up() function:
 *
 *   CREATE TABLE "x"          → CREATE TABLE IF NOT EXISTS "x"
 *   CREATE [UNIQUE] INDEX "x" → … IF NOT EXISTS "x"
 *   ADD COLUMN "x"            → ADD COLUMN IF NOT EXISTS "x"
 *   DROP INDEX / DROP TABLE   → … IF EXISTS
 *   ADD VALUE '…'             → ADD VALUE IF NOT EXISTS '…'
 *   CREATE TYPE …, ADD CONSTRAINT …  → wrapped so "already exists" is skipped
 *
 *   npx tsx scripts/harden-migration.mts src/migrations/<file>.ts
 */
import { readFileSync, writeFileSync } from 'node:fs'

const file = process.argv[2]
if (!file) {
  console.error('usage: tsx scripts/harden-migration.mts <migration.ts>')
  process.exit(1)
}
const src = readFileSync(file, 'utf8')
const [up, ...rest] = src.split('export async function down')
const start = up.indexOf('sql`') + 4
const end = up.lastIndexOf('`)')
if (start < 4 || end < start) throw new Error('No sql`…` block found in up().')

const statements = up
  .slice(start, end)
  .split(/;\s*\n/)
  .map((s) => s.trim().replace(/;$/, ''))
  .filter(Boolean)

const wrap = (s: string) => `DO $$ BEGIN ${s}; EXCEPTION WHEN duplicate_object THEN NULL; END $$`
const hardened = statements.map((s) => {
  if (s.startsWith('DO $$')) return s
  if (s.startsWith('CREATE TYPE') || /^ALTER TABLE "[^"]+" ADD CONSTRAINT/.test(s)) return wrap(s)
  return s
    .replace(/CREATE TABLE "/g, 'CREATE TABLE IF NOT EXISTS "')
    .replace(/CREATE UNIQUE INDEX "/g, 'CREATE UNIQUE INDEX IF NOT EXISTS "')
    .replace(/CREATE INDEX "/g, 'CREATE INDEX IF NOT EXISTS "')
    .replace(/ADD COLUMN "/g, 'ADD COLUMN IF NOT EXISTS "')
    .replace(/DROP INDEX "/g, 'DROP INDEX IF EXISTS "')
    .replace(/DROP TABLE "/g, 'DROP TABLE IF EXISTS "')
    .replace(/ADD VALUE '/g, "ADD VALUE IF NOT EXISTS '")
})

const body = '\n  ' + hardened.join(';\n  ') + ';\n'
const note = '// Safe to re-run: every statement skips what already exists (scripts/harden-migration.mts).\n'
const out = up.slice(0, start) + body + up.slice(end)
writeFileSync(file, out.replace('export async function up', note + 'export async function up') + rest.map((r) => 'export async function down' + r).join(''))
console.log(`hardened ${hardened.length} statements in ${file}`)
