# Database (Vercel-integrated Neon — auto-injected when the store is connected to this project)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Media (auto-injected when the Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Payload — required; the app refuses to start without it. Use 32+ random characters.
PAYLOAD_SECRET=
PAYLOAD_CMS_URL=https://cms.ayraagent.ai

# Migrations run automatically on Vercel PRODUCTION builds only (VERCEL_ENV=production,
# set by Vercel). Previews and local builds never migrate. Locally: `npm run migrate`.

# Local development only: seeds an admin user when absent (ignored in production)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=


# Email (password resets only). Both set: resets are emailed through Resend. Either missing:
# "Forgot password?" is refused and an admin sets a new password (no link is ever logged).
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# One-time admin bootstrap (any environment). Set both in Vercel when nobody can sign in,
# deploy, sign in, then DELETE both. Only creates an account for a new email; never changes one.
PAYLOAD_BOOTSTRAP_ADMIN_EMAIL=
PAYLOAD_BOOTSTRAP_ADMIN_PASSWORD=

# AyraAgent Blogs → posts (src/sync/blogs.ts). Published blogs of a site's AyraAgent org become
# its posts. Per site, set Tenants → AyraAgent Blogs (org, tokenEnv, author) in /admin.
AYRA_AGENT_API_BASE=https://api.ayraagent.ai
# One read-only AyraAgent service token per org, in the env var named by that site's tokenEnv, e.g.
AYRA_BLOGS_TOKEN_SAVELIFE=
# Vercel Cron calls /cron/ayra-blogs with "Authorization: Bearer $CRON_SECRET". Unset = route refused.
CRON_SECRET=

# Sign in with Google (src/lib/google-sso.ts). Both set: the sign-in page shows "Continue with Google".
# Register these redirect URIs on the Google OAuth client: <CMS origin>/auth/google/callback
# (https://cms.ayraagent.ai/auth/google/callback, http://localhost:3100/auth/google/callback).
AYRA_GOOGLE_CLIENT_ID=
AYRA_GOOGLE_CLIENT_SECRET=
# Verified addresses on these domains get an account with no sites on first sign-in; everyone else
# must already have an account. Comma-separated; default neurocare.ai.
AYRA_GOOGLE_ALLOWED_DOMAINS=neurocare.ai
